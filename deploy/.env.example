# teamplanner production stack env. Copy to deploy/.env on the host; never commit .env.
# Real values live in 1Password - reference items here, never values.

# --- Postgres (tp-db; compose assembles the app's DATABASE_URL from these) ---
POSTGRES_USER=teamplanner
POSTGRES_PASSWORD=
POSTGRES_DB=teamplanner

# --- HTTP ---
# Host port the app is published on (drop with the ports: block when behind Traefik).
TP_HTTP_PORT=3000

# --- better-auth (REQUIRED in production) ---
# BETTER_AUTH_URL must be the public URL users reach the app on.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- First-run bootstrap (F31) ---
# Required ONLY to complete first-run setup: generate a long random value, set it,
# then open /setup-admin?token=<value>. Without it the bootstrap endpoints answer 404.
# REMOVE (or leave empty) once the admin password is set - a completed install
# should not keep the bootstrap surface reachable.
BOOTSTRAP_TOKEN=

# Set to true for an invite-only instance: closes public self-registration
# (accounts then come from F9 invitations or F23 admin creation).
AUTH_DISABLE_SIGNUP=false

# --- SMTP ---
# MVP: plain Gmail account (smtp.gmail.com + app password) per
# docs/research-email-delivery.md; hosted/prod switches to a domain sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Google OAuth (F2) - leave empty to hide the Google button ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
