# teamplanner server env. Copy to .env for local overrides; never commit .env.
# Secrets live in 1Password - reference items here, never values.

# better-auth (REQUIRED in production; dev falls back to an insecure default)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database: unset -> embedded PGlite in ./.data/pglite (dev). Set for real Postgres (prod).
DATABASE_URL=
# PGlite data dir override; 'memory' = in-memory (tests)
TEAMPLANNER_DATA_DIR=

# SMTP: unset SMTP_HOST -> mails are captured/logged to console (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Google OAuth (F2) - leave empty to hide the Google button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
