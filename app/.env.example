# teamplanner server env. Copy to .env for local overrides; never commit .env.
# Secrets live in 1Password - reference items here, never values.
# Full reference incl. the F31 first-run ritual: docs/configuration.md

# better-auth (REQUIRED in production; dev falls back to an insecure default)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First-run bootstrap (F31): on a fresh database the seeded admin is unusable
# until you set a token here, restart, and visit /setup-admin?token=<value>.
# Unset = bootstrap endpoints answer 404. Remove again after setup.
BOOTSTRAP_TOKEN=

# true = invite-only: public self-registration off (F9 invitations / F23 admin
# creation remain). Default open.
AUTH_DISABLE_SIGNUP=false

# Database: unset -> embedded PGlite in ./.data/pglite (dev). Set for real Postgres (prod).
DATABASE_URL=
# PGlite data dir override; 'memory' = in-memory (tests)
TEAMPLANNER_DATA_DIR=

# SMTP: unset SMTP_HOST -> mails are captured/logged to console (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Google OAuth (F2) - leave empty to hide the Google button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
